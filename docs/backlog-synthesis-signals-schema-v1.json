{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dckallos/dbt-diagnostics/blob/donkey-kong-sandbox/docs/backlog-synthesis-signals-schema-v1.json",
  "title": "dbt-diagnostics backlog synthesis signals",
  "type": "object",
  "additionalProperties": true,
  "allOf": [{"$ref": "#/$defs/safeObject"}],
  "$defs": {
    "safeValue": {
      "anyOf": [
        {"$ref": "#/$defs/safeObject"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/safeValue"}
        },
        {"type": ["string", "number", "integer", "boolean", "null"]}
      ]
    },
    "safeObject": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/forbiddenReadOnlyShape"}],
      "additionalProperties": {"$ref": "#/$defs/safeValue"}
    },
    "forbiddenReadOnlyShape": {
      "not": {
        "anyOf": [
          {"required": ["operations"]},
          {"required": ["body"]},
          {"required": ["state"]},
          {"required": ["github_request"]},
          {"required": ["github_requests"]},
          {"required": ["github_request_payload"]},
          {"required": ["github_request_payloads"]},
          {"required": ["request_payload"]},
          {"required": ["request_payloads"]},
          {"required": ["rest_request"]},
          {"required": ["rest_requests"]},
          {"required": ["graphql_request"]},
          {"required": ["graphql_requests"]},
          {"required": ["mutation_request"]},
          {"required": ["mutation_requests"]},
          {"required": ["comment"]},
          {"required": ["comments"]},
          {"required": ["issue_comment"]},
          {"required": ["issue_comments"]},
          {"required": ["review_comment"]},
          {"required": ["review_comments"]},
          {"required": ["review_thread"]},
          {"required": ["review_threads"]},
          {"required": ["body_update"]},
          {"required": ["body_updates"]},
          {"required": ["close_request"]},
          {"required": ["close_requests"]},
          {"required": ["label_update"]},
          {"required": ["label_updates"]},
          {"required": ["milestone_update"]},
          {"required": ["milestone_updates"]},
          {"required": ["project_update"]},
          {"required": ["project_updates"]},
          {"required": ["reopen_request"]},
          {"required": ["reopen_requests"]},
          {"required": ["state_update"]},
          {"required": ["state_updates"]},
          {"required": ["title_update"]},
          {"required": ["title_updates"]},
          {"required": ["workflow_dispatch"]},
          {"required": ["workflow_dispatches"]},
          {"required": ["pr_merge"]},
          {"required": ["pr_merges"]},
          {"required": ["pr_merge_instruction"]},
          {"required": ["pr_merge_instructions"]},
          {"required": ["pull_request_merge"]},
          {"required": ["pull_request_merges"]},
          {"required": ["pull_request_merge_instruction"]},
          {"required": ["pull_request_merge_instructions"]},
          {"required": ["issues", "pulls"]},
          {"required": ["issues", "pull_requests"]}
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "repository",
    "generated_at",
    "snapshot_digest",
    "audit_digest",
    "issue_dispositions",
    "signals",
    "near_misses",
    "omissions",
    "safety",
    "backlog_synthesis_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "generated_at": {"type": "string"},
    "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "allOf": [{"$ref": "#/$defs/safeObject"}],
        "required": [
          "issue_number",
          "mechanical_disposition",
          "semantic_hypothesis",
          "recommended_disposition",
          "semantic_evidence_status",
          "evidence"
        ],
        "properties": {
          "issue_number": {"type": "integer", "minimum": 1},
          "mechanical_disposition": {"type": "string", "minLength": 1},
          "semantic_hypothesis": {"type": ["string", "null"]},
          "recommended_disposition": {"type": "string", "minLength": 1},
          "semantic_evidence_status": {
            "enum": ["provided", "unknown"]
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "allOf": [{"$ref": "#/$defs/safeObject"}],
        "required": [
          "signal_type",
          "issue_numbers",
          "confidence",
          "summary",
          "evidence",
          "details"
        ],
        "properties": {
          "signal_type": {"type": "string", "minLength": 1},
          "issue_numbers": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1}
          },
          "confidence": {"enum": ["low", "medium", "high"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "allOf": [{"$ref": "#/$defs/safeObject"}]
          }
        }
      }
    },
    "near_misses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "allOf": [{"$ref": "#/$defs/safeObject"}],
        "required": [
          "near_miss_id",
          "near_miss_type",
          "issue_numbers",
          "score",
          "reason_not_signaled",
          "shared_evidence",
          "details"
        ],
        "properties": {
          "near_miss_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^near-miss-[a-z0-9-]+-[0-9]+(?:-[0-9]+)*-[a-z0-9-]+$"
          },
          "near_miss_type": {"type": "string", "minLength": 1},
          "issue_numbers": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1}
          },
          "score": {"type": "number", "minimum": 0},
          "reason_not_signaled": {"type": "string", "minLength": 1},
          "shared_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "allOf": [{"$ref": "#/$defs/safeObject"}],
            "required": ["reason_category"],
            "properties": {
              "reason_category": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "allOf": [{"$ref": "#/$defs/safeObject"}],
        "required": [
          "omission_id",
          "omission_type",
          "reason",
          "details"
        ],
        "properties": {
          "omission_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^omission-[a-z0-9-]+$"
          },
          "omission_type": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "details": {
            "type": "object",
            "additionalProperties": true,
            "allOf": [{"$ref": "#/$defs/safeObject"}],
            "required": ["reason_category"],
            "properties": {
              "reason_category": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "read_only",
        "github_api_calls",
        "github_mutations",
        "contains_issue_content",
        "contains_state_changes",
        "verdicts_are_advisory"
      ],
      "properties": {
        "read_only": {"const": true},
        "github_api_calls": {"const": false},
        "github_mutations": {"const": false},
        "contains_issue_content": {"const": false},
        "contains_state_changes": {"const": false},
        "verdicts_are_advisory": {"const": true}
      }
    },
    "backlog_synthesis_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
