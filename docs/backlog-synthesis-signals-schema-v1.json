{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dckallos/dbt-diagnostics/blob/donkey-kong-sandbox/docs/backlog-synthesis-signals-schema-v1.json",
  "title": "dbt-diagnostics backlog synthesis signals",
  "type": "object",
  "additionalProperties": true,
  "not": {"required": ["operations"]},
  "required": [
    "schema_version",
    "repository",
    "generated_at",
    "snapshot_digest",
    "audit_digest",
    "issue_dispositions",
    "signals",
    "near_misses",
    "omissions",
    "safety",
    "backlog_synthesis_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "generated_at": {"type": "string"},
    "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issue_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "not": {
          "anyOf": [
            {"required": ["body"]},
            {"required": ["state"]}
          ]
        },
        "required": [
          "issue_number",
          "mechanical_disposition",
          "semantic_hypothesis",
          "recommended_disposition",
          "semantic_evidence_status",
          "evidence"
        ],
        "properties": {
          "issue_number": {"type": "integer", "minimum": 1},
          "mechanical_disposition": {"type": "string", "minLength": 1},
          "semantic_hypothesis": {"type": ["string", "null"]},
          "recommended_disposition": {"type": "string", "minLength": 1},
          "semantic_evidence_status": {
            "enum": ["provided", "unknown"]
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "not": {
          "anyOf": [
            {"required": ["body"]},
            {"required": ["state"]}
          ]
        },
        "required": [
          "signal_type",
          "issue_numbers",
          "confidence",
          "summary",
          "evidence",
          "details"
        ],
        "properties": {
          "signal_type": {"type": "string", "minLength": 1},
          "issue_numbers": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1}
          },
          "confidence": {"enum": ["low", "medium", "high"]},
          "summary": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "not": {
              "anyOf": [
                {"required": ["body"]},
                {"required": ["state"]}
              ]
            }
          }
        }
      }
    },
    "near_misses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "not": {
          "anyOf": [
            {"required": ["body"]},
            {"required": ["state"]},
            {"required": ["operations"]},
            {"required": ["github_request"]},
            {"required": ["github_requests"]},
            {"required": ["github_request_payload"]},
            {"required": ["request_payload"]},
            {"required": ["graphql_request"]},
            {"required": ["mutation_request"]},
            {"required": ["body_update"]},
            {"required": ["state_update"]},
            {"required": ["comment"]},
            {"required": ["comments"]}
          ]
        },
        "required": [
          "near_miss_id",
          "near_miss_type",
          "issue_numbers",
          "score",
          "reason_not_signaled",
          "shared_evidence",
          "details"
        ],
        "properties": {
          "near_miss_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^near-miss-[a-z0-9-]+-[0-9]+(?:-[0-9]+)*-[a-z0-9-]+$"
          },
          "near_miss_type": {"type": "string", "minLength": 1},
          "issue_numbers": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1}
          },
          "score": {"type": "number", "minimum": 0},
          "reason_not_signaled": {"type": "string", "minLength": 1},
          "shared_evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "not": {
              "anyOf": [
                {"required": ["body"]},
                {"required": ["state"]},
                {"required": ["operations"]},
                {"required": ["github_request"]},
                {"required": ["request_payload"]},
                {"required": ["body_update"]},
                {"required": ["state_update"]},
                {"required": ["comment"]},
                {"required": ["comments"]}
              ]
            },
            "required": ["reason_category"],
            "properties": {
              "reason_category": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "not": {
          "anyOf": [
            {"required": ["body"]},
            {"required": ["state"]},
            {"required": ["operations"]},
            {"required": ["github_request"]},
            {"required": ["github_requests"]},
            {"required": ["github_request_payload"]},
            {"required": ["request_payload"]},
            {"required": ["graphql_request"]},
            {"required": ["mutation_request"]},
            {"required": ["body_update"]},
            {"required": ["state_update"]},
            {"required": ["comment"]},
            {"required": ["comments"]}
          ]
        },
        "required": [
          "omission_id",
          "omission_type",
          "reason",
          "details"
        ],
        "properties": {
          "omission_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^omission-[a-z0-9-]+$"
          },
          "omission_type": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "details": {
            "type": "object",
            "additionalProperties": true,
            "not": {
              "anyOf": [
                {"required": ["body"]},
                {"required": ["state"]},
                {"required": ["operations"]},
                {"required": ["github_request"]},
                {"required": ["request_payload"]},
                {"required": ["body_update"]},
                {"required": ["state_update"]},
                {"required": ["comment"]},
                {"required": ["comments"]}
              ]
            },
            "required": ["reason_category"],
            "properties": {
              "reason_category": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "read_only",
        "github_api_calls",
        "github_mutations",
        "contains_issue_content",
        "contains_state_changes",
        "verdicts_are_advisory"
      ],
      "properties": {
        "read_only": {"const": true},
        "github_api_calls": {"const": false},
        "github_mutations": {"const": false},
        "contains_issue_content": {"const": false},
        "contains_state_changes": {"const": false},
        "verdicts_are_advisory": {"const": true}
      }
    },
    "backlog_synthesis_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
