{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dckallos/dbt-diagnostics/blob/donkey-kong-sandbox/docs/synthesis-review-packet-schema-v1.json",
  "title": "dbt-diagnostics synthesis review packet",
  "type": "object",
  "additionalProperties": true,
  "allOf": [{"$ref": "#/$defs/safeObject"}],
  "not": {
    "anyOf": [
      {"required": ["operations"]},
      {"required": ["github_request"]},
      {"required": ["github_requests"]},
      {"required": ["github_request_payload"]},
      {"required": ["request_payload"]}
    ]
  },
  "$defs": {
    "safeValue": {
      "anyOf": [
        {"$ref": "#/$defs/safeObject"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/safeValue"}
        },
        {"type": ["string", "number", "integer", "boolean", "null"]}
      ]
    },
    "safeObject": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/forbiddenReadOnlyShape"}],
      "additionalProperties": {"$ref": "#/$defs/safeValue"}
    },
    "forbiddenReadOnlyShape": {
      "not": {
        "anyOf": [
          {"required": ["operations"]},
          {"required": ["body"]},
          {"required": ["state"]},
          {"required": ["github_request"]},
          {"required": ["github_requests"]},
          {"required": ["github_request_payload"]},
          {"required": ["github_request_payloads"]},
          {"required": ["request_payload"]},
          {"required": ["request_payloads"]},
          {"required": ["rest_request"]},
          {"required": ["rest_requests"]},
          {"required": ["graphql_request"]},
          {"required": ["graphql_requests"]},
          {"required": ["mutation_request"]},
          {"required": ["mutation_requests"]},
          {"required": ["comment"]},
          {"required": ["comments"]},
          {"required": ["issue_comment"]},
          {"required": ["issue_comments"]},
          {"required": ["review_comment"]},
          {"required": ["review_comments"]},
          {"required": ["review_thread"]},
          {"required": ["review_threads"]},
          {"required": ["body_update"]},
          {"required": ["body_updates"]},
          {"required": ["close_request"]},
          {"required": ["close_requests"]},
          {"required": ["label_update"]},
          {"required": ["label_updates"]},
          {"required": ["milestone_update"]},
          {"required": ["milestone_updates"]},
          {"required": ["project_update"]},
          {"required": ["project_updates"]},
          {"required": ["reopen_request"]},
          {"required": ["reopen_requests"]},
          {"required": ["state_update"]},
          {"required": ["state_updates"]},
          {"required": ["title_update"]},
          {"required": ["title_updates"]},
          {"required": ["issues", "pulls"]},
          {"required": ["issues", "pull_requests"]}
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "repository",
    "generated_at",
    "source_generated_at",
    "source_artifacts",
    "packet_scope",
    "candidate_sets",
    "evidence_items",
    "near_misses",
    "omissions",
    "comments_included",
    "comment_evidence_status",
    "budget",
    "staleness",
    "safety",
    "synthesis_review_packet_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "generated_at": {"type": "string"},
    "source_generated_at": {"type": "string"},
    "source_artifacts": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "snapshot_digest",
        "audit_digest",
        "backlog_synthesis_digest"
      ],
      "properties": {
        "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "audit_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "backlog_synthesis_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "project_plan_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "packet_scope": {
      "type": "object",
      "additionalProperties": true
    },
    "candidate_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{"$ref": "#/$defs/safeObject"}],
        "additionalProperties": true
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [{"$ref": "#/$defs/safeObject"}],
        "additionalProperties": true,
        "required": ["evidence_id"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "excerpt": {"type": "string", "minLength": 1}
        }
      }
    },
    "near_misses": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "allOf": [{"$ref": "#/$defs/safeObject"}],
            "additionalProperties": true,
            "properties": {
              "near_miss_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^near-miss-[a-z0-9-]+-[0-9]+(?:-[0-9]+)*-[a-z0-9-]+$"
              },
              "near_miss_type": {"type": "string", "minLength": 1},
              "issue_numbers": {
                "type": "array",
                "items": {"type": "integer", "minimum": 1}
              },
              "score": {"type": "number", "minimum": 0},
              "reason_not_signaled": {"type": "string", "minLength": 1},
              "shared_evidence": {
                "type": "array",
                "items": {"type": "string"}
              },
              "details": {"type": "object"}
            }
          }
        ]
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string"},
          {
            "type": "object",
            "allOf": [{"$ref": "#/$defs/safeObject"}],
            "additionalProperties": true,
            "properties": {
              "omission_id": {"type": "string", "minLength": 1},
              "omission_type": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "details": {"type": "object"}
            }
          }
        ]
      }
    },
    "comments_included": {"const": false},
    "comment_evidence_status": {"const": "not_collected"},
    "budget": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "serialized_bytes",
        "target_bytes",
        "hard_bytes",
        "estimated_tokens",
        "target_estimated_tokens",
        "hard_estimated_tokens",
        "token_estimate_method"
      ],
      "properties": {
        "serialized_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 307200
        },
        "target_bytes": {"const": 204800},
        "hard_bytes": {"const": 307200},
        "estimated_tokens": {"type": "integer", "minimum": 0},
        "target_estimated_tokens": {"const": 50000},
        "hard_estimated_tokens": {"const": 75000},
        "token_estimate_method": {"type": "string", "minLength": 1},
        "budget_warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "serialized_bytes_exceeds_target_bytes",
              "estimated_tokens_exceeds_target"
            ]
          }
        }
      }
    },
    "staleness": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "max_age_hours",
        "stale",
        "llm_review_allowed"
      ],
      "properties": {
        "source_generated_at": {"type": "string", "minLength": 1},
        "evaluated_at": {"type": "string", "minLength": 1},
        "source_age_hours": {"type": "number", "minimum": 0},
        "warning_age_hours": {"const": 24},
        "max_age_hours": {"type": "integer", "minimum": 1},
        "freshness_status": {
          "type": "string",
          "enum": ["fresh", "warning", "stale"]
        },
        "freshness_warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "stale": {"type": "boolean"},
        "llm_review_allowed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"stale": {"const": true}},
            "required": ["stale"]
          },
          "then": {
            "properties": {"llm_review_allowed": {"const": false}}
          }
        }
      ]
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "read_only",
        "github_api_calls",
        "github_mutations",
        "contains_executable_operations",
        "contains_full_tracker_snapshot",
        "contains_issue_comments",
        "comments_included",
        "llm_verdicts_are_advisory"
      ],
      "properties": {
        "read_only": {"const": true},
        "github_api_calls": {"const": false},
        "github_mutations": {"const": false},
        "contains_executable_operations": {"const": false},
        "contains_full_tracker_snapshot": {"const": false},
        "contains_issue_comments": {"const": false},
        "comments_included": {"const": false},
        "llm_verdicts_are_advisory": {"const": true}
      }
    },
    "synthesis_review_packet_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
