{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel)\"; exec \"$root/.venv/bin/python\" \"$root/.codex/hooks/pre_tool_use.py\"'",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel)\"; exec \"$root/.venv/bin/python\" \"$root/.codex/hooks/permission_request.py\"'",
            "timeout": 10,
            "statusMessage": "Checking approval safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel)\"; exec \"$root/.venv/bin/python\" \"$root/.codex/hooks/stop.py\"'",
            "timeout": 10,
            "statusMessage": "Checking Codex quality receipt"
          }
        ]
      }
    ]
  }
}
