{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec .codex/hooks/run_hook.sh pre_tool_use.py PreToolUse'",
            "timeout": 10,
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec .codex/hooks/run_hook.sh permission_request.py PermissionRequest'",
            "timeout": 10,
            "statusMessage": "Checking approval safety"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'exec .codex/hooks/run_hook.sh stop.py Stop'",
            "timeout": 10,
            "statusMessage": "Checking Codex quality receipt"
          }
        ]
      }
    ]
  }
}
